# ---------- Dockerfile.rocm ----------
# AMD ROCm llama.cpp variant — uses GGUF models with dynamic GPU-layer offload.
FROM rocm/pytorch:latest

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HSA_ENABLE_SDMA=0 \
    TRANSCRIBER_ANALYSIS_BACKEND=llama_cpp \
    TRANSCRIBER_GGUF_CACHE_DIR=/cache/transcriber/gguf

ARG AMDGPU_TARGETS="gfx1030"

# System packages (base image may already have some; we add for safety)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        libopenblas-dev \
        libsndfile1 \
        ffmpeg \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG USER_ID=1000
ARG GROUP_ID=1000
# rocm/pytorch already ships an `ubuntu` user/group with UID/GID 1000.
# Reuse those IDs when present so custom USER_ID/GROUP_ID builds still work.
RUN existing_group="$(getent group "$GROUP_ID" | cut -d: -f1 || true)" && \
    if [ -n "$existing_group" ] && [ "$existing_group" != "appgroup" ]; then \
        groupmod -n appgroup "$existing_group"; \
    elif [ -z "$existing_group" ]; then \
        addgroup --gid "$GROUP_ID" appgroup; \
    fi && \
    existing_user="$(getent passwd "$USER_ID" | cut -d: -f1 || true)" && \
    if [ -n "$existing_user" ] && [ "$existing_user" != "appuser" ]; then \
        usermod -l appuser -d /home/appuser -m -g "$GROUP_ID" "$existing_user"; \
    elif [ -z "$existing_user" ]; then \
        adduser --uid "$USER_ID" --gid "$GROUP_ID" --disabled-password --gecos "" appuser; \
    else \
        usermod -g "$GROUP_ID" appuser; \
    fi

WORKDIR /tmp/build

# ---- install all Python deps first (gets faster-whisper, pytest, etc.) ----
# ctranslate2 is pulled as a transitive dep of faster-whisper; we overwrite
# it below with the HIP source build.  llama-cpp-python gets the default
# CPU wheel and is overwritten afterwards with the HIP source build.
COPY requirements.txt /tmp/build/
RUN python -m pip install --no-cache-dir -r requirements.txt

# ---- build CTranslate2 from source with -DWITH_HIP=ON ----
# CTranslate2 does not ship ROCm/HIP wheels on PyPI or any wheel index.
# We build the C++ library first, then compile the Python wrapper that
# links against it — the same two-stage pattern upstream documents:
#   https://github.com/OpenNMT/CTranslate2/blob/master/docs/installation.md
ARG CTRL2_VERSION=v4.7.1
RUN git clone --branch "${CTRL2_VERSION}" --depth 1 --recurse-submodules \
        https://github.com/OpenNMT/CTranslate2.git \
        /tmp/build/ctranslate2 && \
    cd /tmp/build/ctranslate2 && \
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/opt/ctranslate2 \
        -DCMAKE_C_COMPILER=amdclang \
        -DCMAKE_CXX_COMPILER=amdclang++ \
        -DWITH_HIP=ON \
        -DWITH_MKL=OFF \
        -DWITH_DNNL=OFF \
        -DWITH_CUDNN=OFF \
        -DWITH_OPENBLAS=ON \
        -DOPENMP_RUNTIME=COMP \
        -DCMAKE_HIP_ARCHITECTURES="${AMDGPU_TARGETS}" \
        -DGPU_TARGETS="${AMDGPU_TARGETS}" \
        -DCMAKE_CXX_FLAGS="-O3 -Wno-deprecated-literal-operator" \
        -DCMAKE_HIP_FLAGS="-O3 -Wno-deprecated-literal-operator" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_CLI=OFF \
        -DBUILD_TESTS=OFF && \
    cmake --build build --parallel "$(nproc)" && \
    cmake --install build && \
    ldconfig

ENV CTRANSLATE2_ROOT=/opt/ctranslate2 \
    LD_LIBRARY_PATH=/opt/ctranslate2/lib:/opt/rocm/lib/llvm/lib:${LD_LIBRARY_PATH:-}

# ---- build Python wrapper so ctranslate2 points to the HIP library ----
RUN cd /tmp/build/ctranslate2/python && \
    pip install -r install_requirements.txt && \
    python setup.py bdist_wheel && \
    pip install --no-cache-dir --force-reinstall dist/*.whl

# ---- build llama-cpp-python from source with HIP support ----
RUN CMAKE_ARGS="-DGGML_HIP=on -DAMDGPU_TARGETS=${AMDGPU_TARGETS}" \
    FORCE_CMAKE=1 \
    python -m pip install --no-cache-dir --force-reinstall --no-binary llama-cpp-python llama-cpp-python

# ---- clean up build tree to keep the image small ----
RUN rm -rf /tmp/build

# ---- copy application code ----
WORKDIR /app
COPY . /app/
RUN mkdir -p /cache/transcriber/gguf && \
    chown -R appuser:appgroup /cache/transcriber
USER appuser
ENTRYPOINT ["python", "transcribe.py"]
# --------------------------------------
